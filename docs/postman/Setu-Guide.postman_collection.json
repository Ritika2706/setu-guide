{
  "info": {
    "name": "Setu Guide API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Setu Guide assistant API (v1.0.0). Collection variable `base_url` defaults to local `http://localhost:8000`. For staging, set `base_url` to `https://setu-guide.onrender.com`. Synthetic IDs only (devops-day3-user-001 / devops-day3-match-001) — never send real user data.\n\nMANUAL rate-limit test (do NOT automate against staging defaults): temporarily set RATE_LIMIT_PER_USER=3/minute on a scratch instance, send the quick-action 4x, expect 3x200 then 429 with numeric Retry-After. No 429 request is automated in this collection."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "GET health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('body is {status:ok}', function () { pm.expect(pm.response.json()).to.eql({status: 'ok'}); });",
                  "pm.test('X-Request-Id present', function () { pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty; });",
                  "pm.test('no X-Cache on health', function () { pm.expect(pm.response.headers.get('X-Cache'), 'X-Cache must be absent').to.be.undefined; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Chat",
      "item": [
        {
          "name": "Successful quick-action",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/v1/guide/chat",
              "host": ["{{base_url}}"],
              "path": ["v1", "guide", "chat"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"devops-day3-user-001\",\n  \"match_id\": \"devops-day3-match-001\",\n  \"stage\": \"connect\",\n  \"intent\": \"next_steps\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('has all 7 response fields', function () {",
                  "    var b = pm.response.json();",
                  "    pm.expect(b).to.have.all.keys('intent','reply','questions','chips','sources','safety','fallback_used');",
                  "    pm.expect(b.intent).to.eql('next_steps');",
                  "    pm.expect(b.reply).to.be.a('string').and.not.empty;",
                  "    pm.expect(b.questions.length).to.be.at.most(5);",
                  "    pm.expect(b.chips.length).to.be.at.most(4);",
                  "    pm.expect(b.safety.status).to.eql('pass');",
                  "    pm.expect(b.safety.flags).to.eql([]);",
                  "    pm.expect(b.fallback_used).to.eql(false);",
                  "});",
                  "pm.test('X-Request-Id and X-Cache present', function () {",
                  "    pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty;",
                  "    pm.expect(['HIT','MISS']).to.include(pm.response.headers.get('X-Cache'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Message-based chat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/v1/guide/chat",
              "host": ["{{base_url}}"],
              "path": ["v1", "guide", "chat"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"devops-day3-user-002\",\n  \"match_id\": \"devops-day3-match-002\",\n  \"stage\": \"understand\",\n  \"message\": \"What are some good questions to ask?\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('routed intent is a valid enum', function () {",
                  "    var b = pm.response.json();",
                  "    pm.expect(['conversation_ideas','help_me_understand','next_steps','privacy_safety']).to.include(b.intent);",
                  "    pm.expect(b.reply).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('X-Cache is MISS for free text', function () {",
                  "    pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Chat with topic-context",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/v1/guide/chat",
              "host": ["{{base_url}}"],
              "path": ["v1", "guide", "chat"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"devops-day3-user-003\",\n  \"match_id\": \"devops-day3-match-003\",\n  \"stage\": \"connect\",\n  \"intent\": \"next_steps\",\n  \"topic\": \"weekend plans\",\n  \"context\": {\n    \"viewer\": {\"interests\": [\"travel\"], \"languages\": [\"en\"]},\n    \"match\": {\"lifestyle\": \"balanced\"}\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('shape is GuideResponse', function () {",
                  "    var b = pm.response.json();",
                  "    pm.expect(b).to.have.all.keys('intent','reply','questions','chips','sources','safety','fallback_used');",
                  "    pm.expect(b.safety.status).to.eql('pass');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
