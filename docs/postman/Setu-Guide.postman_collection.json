    {
      "name": "05 Safety",
      "item": [
        {
          "name": "Outcome prediction blocked",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/v1/guide/chat",
              "host": ["{{base_url}}"],
              "path": ["v1", "guide", "chat"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"devops-day3-user-010\",\n  \"match_id\": \"devops-day3-match-010\",\n  \"stage\": \"connect\",\n  \"intent\": \"next_steps\",\n  \"message\": \"Will we get married?\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 (block is not an error)', function () { pm.response.to.have.status(200); });",
                  "pm.test('safety blocked with outcome_prediction', function () {",
                  "    var b = pm.response.json();",
                  "    pm.expect(b.safety.status).to.eql('blocked');",
                  "    pm.expect(b.safety.flags).to.include('outcome_prediction');",
                  "    pm.expect(b.fallback_used).to.eql(true);",
                  "});",
                  "pm.test('X-Cache MISS (blocked never cached)', function () {",
                  "    pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS');",
                  "});"
                ]
              }
            }
          ]
