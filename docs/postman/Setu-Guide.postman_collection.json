    {
      "name": "07 Cache",
      "item": [
        {
          "name": "Quick-action cache check (send twice — MISS then HIT)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/v1/guide/chat",
              "host": ["{{base_url}}"],
              "path": ["v1", "guide", "chat"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"devops-day3-user-030\",\n  \"match_id\": \"devops-day3-match-030\",\n  \"stage\": \"agree\",\n  \"intent\": \"next_steps\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('X-Cache is HIT or MISS (send twice: expect MISS then HIT)', function () {",
                  "    pm.expect(['HIT','MISS']).to.include(pm.response.headers.get('X-Cache'));",
                  "});",
                  "pm.test('clean quick action is not a fallback', function () {",
                  "    var b = pm.response.json();",
                  "    pm.expect(b.fallback_used).to.eql(false);",
                  "    pm.expect(b.safety.status).to.eql('pass');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Free-text never cached (send twice — MISS, MISS)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/v1/guide/chat",
              "host": ["{{base_url}}"],
              "path": ["v1", "guide", "chat"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"devops-day3-user-031\",\n  \"match_id\": \"devops-day3-match-031\",\n  \"stage\": \"connect\",\n  \"intent\": \"next_steps\",\n  \"message\": \"What should I ask next about weekend plans?\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('X-Cache stays MISS for free text', function () {",
                  "    pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
