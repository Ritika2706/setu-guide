# Setu Guide - environment template. Copy to .env and fill in real values:
#     cp .env.example .env
# .env is ignored by git AND by docker (see .gitignore / .dockerignore),
# so secrets never leave your machine. Never commit a real key.

# ---------------------------------------------------------------- LLM
# PLACEHOLDER - default keeps the Day 1 mock reply. Flip to false only once
# app.core.orchestrator.handle_chat exists and a real key is set.
USE_MOCK=true
# PLACEHOLDER - real provider name comes from the responder owner.
LLM_PROVIDER=placeholder
# Secret. Required only when USE_MOCK=false. Never logged, never in the image.
LLM_API_KEY=placeholder-not-a-real-key
# PLACEHOLDER - overall budget is this + a small margin (1s).
LLM_TIMEOUT_SECONDS=10

# --------------------------------------------------------- rate limiting
# Format: <count>/<period> with period = second, minute, hour or day.
# PLACEHOLDER - confirm 30/min per user and 60/min per IP with the lead.
RATE_LIMIT_PER_USER=30/minute
RATE_LIMIT_PER_IP=60/minute
# true only behind a reverse proxy we control (nginx/ALB), otherwise
# X-Forwarded-For is ignored so clients cannot forge their own bucket.
TRUSTED_PROXY=false

# ---------------------------------------------------------- response cache
# Set CACHE_ENABLED=false for the 5-run consistency check (always MISS).
CACHE_ENABLED=true
# PLACEHOLDER - 600s / 500 items to be confirmed.
CACHE_TTL_SECONDS=600
CACHE_MAX_ITEMS=500

# ----------------------------------------------------------------- logging
# CRITICAL | ERROR | WARNING | INFO | DEBUG | NOTSET
# Logs never contain the message, topic, ids or the API key.
LOG_LEVEL=INFO

# --------------------------------------------- kept for other owners
# (Day 1 value, used by the shared local setup - not read by this service yet.)
INTERNAL_API_KEY=
